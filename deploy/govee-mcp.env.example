GOVEE_API_KEY=your-govee-api-key
GOVEE_MCP_PUBLIC_URL=https://govee.example.com
# The password you type when connecting a new app. At least 12 characters.
GOVEE_MCP_PASSWORD=change-me-to-something-long
# Local port the reverse proxy forwards to (Caddyfile uses 8000, nginx-govee-mcp.conf uses 8765).
GOVEE_MCP_PORT=8000
